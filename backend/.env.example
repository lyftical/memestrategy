# ── RPC ─────────────────────────────────────────────────────────────
# Use a paid/keyed RPC (Helius, QuickNode, Triton). Public mainnet RPC
# will rate-limit you and often disables getProgramAccounts (needed for
# holder snapshots). Helius example:
# https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=

# ── Treasury wallet ─────────────────────────────────────────────────
# Base58 secret key (Phantom export) OR a JSON byte array [12,34,...].
# USE A FRESH WALLET CREATED ONLY FOR THIS. Never your main wallet.
# Generate one with: npm run wallet -- new
TREASURY_SECRET_KEY=

# ── Tokens ──────────────────────────────────────────────────────────
# Pump tokens to buy, format: MINT:WEIGHT,MINT:WEIGHT
# Weights are relative (2 gets twice the SOL of 1). Example:
# TOKENS=6p6xgHy...pump:2,8FnkT9...pump:1
TOKENS=

# $MSTR mint address — leave empty until launch. Distributions are
# disabled while this is empty; buying still works.
MSTR_MINT=

# ── Buy engine ──────────────────────────────────────────────────────
AUTO_BUY=true
BACKFILL_ON_BOOT=false     # one-shot recovery scan of recent txs on boot (idempotent)
MIN_DEPOSIT_SOL=0.01          # ignore dust deposits
RESERVE_SOL=0.05              # always keep this much SOL for fees/rent
SLIPPAGE_BPS=300              # 3% — pump tokens are volatile
PRIORITY_FEE_MICROLAMPORTS=100000
WATCH_INTERVAL_SEC=20
# Jupiter free tier. If you get an API key use https://api.jup.ag/swap/v1
JUPITER_BASE=https://lite-api.jup.ag/swap/v1

# ── Distribution ────────────────────────────────────────────────────
AUTO_DISTRIBUTE=false         # start manual: npm run distribute
DISTRIBUTION_INTERVAL_HOURS=24
MIN_HOLDER_UI_BALANCE=1       # holders below this many MSTR get nothing
# Automatically exclude program-owned holders (liquidity pools, bonding
# curves, AMM vaults) from distributions. Wallets are System-Program-owned;
# pools are not — no manual LP address needed. Default true.
AUTO_EXCLUDE_POOLS=true
# Addresses excluded from distributions (LP pools, bonding curve,
# burn address, your own wallets). Comma-separated. The treasury
# itself is always excluded automatically.
EXCLUDED_ADDRESSES=

# ── API ─────────────────────────────────────────────────────────────
PORT=8787
# Secret for the manual-trigger endpoints (POST /api/admin/*)
ADMIN_KEY=change-me
